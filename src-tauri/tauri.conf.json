{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "warthunderlivedownloadmanager",
  "version": "0.1.0",
  "identifier": "com.warthunderlivedownloadmanager.app",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node server.js",
    "beforeBuildCommand": "npm run build:backend"
  },
  "app": {
    "windows": [
      {
        "title": "War Thunder Live Download Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/wt-live-manager-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
